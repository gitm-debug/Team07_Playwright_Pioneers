import { Given, When, Then } from '@cucumber/cucumber';
import { ProgramPage } from '../pages/program.page.js';

let programPage;

Given('I am on the Program page', async function () {
    programPage = new ProgramPage(this.page);
    await this.page.goto(/programPage/);
    await this.page.waitForLoadState('networkidle');
});

When('I click the Next page button', async function () {
    await programPage.clickNextPage();
});

When('I click the Previous page button', async function () {
    await programPage.clickPreviousPage();
});

When('I click the First page button', async function () {
    await programPage.clickFirstPage();
});

When('I click the Last page button', async function () {
    await programPage.clickLastPage();
});

When('I click page number {int}', async function (pageNumber) {
    await programPage.clickPageNumber(pageNumber);
});

Then('the pagination controls should be visible', async function () {
    const visible = await programPage.isPaginationVisible();
    if (!visible) {
        throw new Error('Pagination controls are not visible');
    }
});